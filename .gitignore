# Local-only project notes
context.md
presentation_notes.md
agents.md
CLAUDE.md

# Source PDFs (copyrighted; sources.yaml points at the public URLs)
*.pdf

# Ground truth content stays local: raw.html, text.md, page.md and the
# full PDF text. Only meta.json is published. Short cited snippets with
# page references are published separately, in verdicts.json.
data/ground_truth/*/*
!data/ground_truth/*/meta.json

# Rendered snapshot files: derived from reports/geo_snapshot.md by
# src/render_snapshot.py (PDF) and src/render_snapshot_docx.js (Word);
# they go stale as soon as the snapshot regenerates, so are never committed.
reports/geo_snapshot.pdf
reports/geo_snapshot.docx
reports/geo_snapshot.html

# Python virtualenv and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Collection working sheet (local, used during the session)
collection_sheet.md

# Scratch and local-only files
scratch/
*.local.*
.claude/
